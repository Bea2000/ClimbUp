model Sector {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  competitionId Int
  competition  Competition @relation("CompetitionSectors", fields: [competitionId], references: [id])
  problems     Problem[] @relation("SectorProblems")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
